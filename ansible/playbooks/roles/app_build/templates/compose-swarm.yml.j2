version: '3.8'

services:
  traefik:
    image: traefik:v2.8
    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: ingress
      - target: 443
        published: 443
        protocol: tcp
        mode: ingress
      - target: 8080
        published: 8080
        protocol: tcp
        mode: ingress
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/docker/traefik/config/traefik.yml:/etc/traefik/traefik.yml:ro
      - /opt/docker/traefik/config:/opt/docker/traefik/config:ro
    networks:
      - traefik-public
    deploy:
      mode: global
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure
      labels:
        traefik.enable: "false"

  database:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: "{{ vault_db_root_password }}"
      MYSQL_DATABASE: "{{ db_name }}"
      MYSQL_USER: "{{ db_user }}"
      MYSQL_PASSWORD: "{{ vault_db_password }}"
      MYSQL_CHARACTER_SET_SERVER: utf8mb4
      MYSQL_COLLATION_SERVER: utf8mb4_unicode_ci
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - app_network
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
      labels:
        traefik.enable: "false"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "{{ db_user }}", "-p{{ vault_db_password }}"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  backend:
    image: "{{ docker_hub_username}}/backend:{{ deploy_version }}"
    environment:
      - DB_HOST=database
      - DB_PORT={{ db_port }}
      - DB_NAME={{ db_name }}
      - DB_USER={{ db_user }}
      - DB_PASSWORD={{ vault_db_password }}
      - ENVIRONMENT={{app_environment}}
      - CORS_ORIGINS={{ backend_cors_origins | to_json }}
    networks:
      - app_network
      - traefik-public
      - monitoring_network
    depends_on:
      - database
    deploy:
      replicas: {{ backend_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          memory: 512M
          cpus: '0.50'
        reservations:
          memory: 256M
          cpus: '0.25'
      labels:
        traefik.enable: "true"
        traefik.http.routers.backend.rule: "Host(`api.sneakerportfolio.eu`)"
        traefik.http.routers.backend.entrypoints: "web"
        traefik.http.services.backend.loadbalancer.server.port: "5000"
        traefik.docker.network: "traefik-public"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  frontend:
    image: "{{ docker_hub_username}}/frontend:{{ deploy_version }}"
    environment:
      - REACT_APP_API_URL=https://api.sneakerportfolio.eu
      - REACT_APP_ENVIRONMENT=production
    networks:
      - traefik-public
    depends_on:
      - backend
    deploy:
      replicas: {{ frontend_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          memory: 128M
          cpus: '0.25'
        reservations:
          memory: 64M
          cpus: '0.10'
      labels:
        traefik.enable: "true"
        traefik.http.routers.frontend.rule: "Host(`sneakerportfolio.eu`)"
        traefik.http.routers.frontend.entrypoints: "web"
        traefik.http.services.frontend.loadbalancer.server.port: "7000"
        traefik.docker.network: "traefik-public"

  prometheus:
    image: prom/prometheus:latest
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time={{ prometheus_retention_time }}'
      - '--web.enable-lifecycle'
      - '--web.enable-admin-api'
    volumes:
      - prometheus_data:/prometheus
      - /opt/monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /opt/monitoring/prometheus/console_libraries:/etc/prometheus/console_libraries:ro
      - /opt/monitoring/prometheus/consoles:/etc/prometheus/consoles:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - monitoring_network
      - traefik-public
      - app_network
    ports:
      - target: 9090
        published: 9090
        protocol: tcp
        mode: ingress
    deploy:
      placement:
        constraints:
          - node.role == manager
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        traefik.enable: "true"
        traefik.http.routers.prometheus.rule: "Host(`prometheus.sneakerportfolio.eu`)"
        traefik.http.routers.prometheus.entrypoints: "web"
        traefik.http.services.prometheus.loadbalancer.server.port: "9090"
        traefik.docker.network: "traefik-public"

  grafana:
    image: grafana/grafana:latest
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_SERVER_DOMAIN: "{{ grafana_domain }}"
      GF_SERVER_ROOT_URL: "http://{{ grafana_domain }}"
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - /opt/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring_network
      - traefik-public
    depends_on:
      - prometheus
    deploy:
      placement:
        constraints:
          - node.role == manager
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        traefik.enable: "true"
        traefik.http.routers.grafana.rule: "Host(`grafana.sneakerportfolio.eu`)"
        traefik.http.routers.grafana.entrypoints: "web"
        traefik.http.services.grafana.loadbalancer.server.port: "3000"
        traefik.docker.network: "traefik-public"

  node-exporter:
    image: quay.io/prometheus/node-exporter:latest
    command:
      - '--path.rootfs=/host'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
      - '--collector.systemd'
      - '--web.listen-address=:9100'
    volumes:
      - '/:/host:ro,rslave'
      - '/proc:/host/proc:ro'
      - '/sys:/host/sys:ro'
      - '/var/run/docker.sock:/var/run/docker.sock:ro'
    networks:
      - monitoring_network
    deploy:
      mode: global
      placement:
        constraints:
          - node.platform.os == linux
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 128M
          cpus: "0.10"
        reservations:
          memory: 64M
          cpus: "0.05"
      labels:
        traefik.enable: "false"

  health-check:
    image: nginx:alpine
    networks:
      - traefik-public
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        traefik.enable: "false"
    command: >
      sh -c "echo 'server { listen 80; location / { return 200 \"OK\"; add_header Content-Type text/plain; } }' > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"

networks:
  traefik-public:
    external: true
  app_network:
    driver: overlay
    attachable: true
  monitoring_network:
    external: true

volumes:
  mysql_data:
    external: true
  prometheus_data:
    external: true
  grafana_data:
    external: true
