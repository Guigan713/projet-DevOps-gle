version: '3.8'

services:
  traefik:
    image: traefik:v3.0
    command:
      - "--api.dashboard=true"
      - "--api.insecure=false"
      - "--providers.docker=true"
      - "--providers.swarm.endpoint=unix:///var/run/docker.sock"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.network=traefik-public"
      - "--providers.docker.watch=true"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email={{ acme_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      - "--metrics.prometheus=true"
    ports:
      - "80:80"
      - "443:443"
      - "8080:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/docker/letsencrypt:/letsencrypt
    environment:
      GOOGLE_APPLICATION_CREDENTIALS: "/gcp-service-account.json"
    networks:
      - traefik-public
    deploy:
      placement:
        constraints:
          - node.hostname == swarm-manager-1
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.traefik-dashboard.rule=Host(`{{ traefik_domain }}`)"
        - "traefik.http.routers.traefik-dashboard.entrypoints=web,websecure"
        - "traefik.http.routers.traefik-dashboard.tls.certresolver=letsencrypt"
        - "traefik.http.routers.traefik-dashboard.service=api@internal"
        - "traefik.http.services.api.loadbalancer.server.port=8080"
        - "traefik.docker.network=traefik-public"

  database:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: "{{ vault_db_root_password }}"
      MYSQL_DATABASE: "{{ db_name }}"
      MYSQL_USER: "{{ db_user }}"
      MYSQL_PASSWORD: "{{ vault_db_password }}"
      MYSQL_CHARACTER_SET_SERVER: utf8mb4
      MYSQL_COLLATION_SERVER: utf8mb4_unicode_ci
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - app_network
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 512M
        reservations:
          memory: 256M
      labels:
        - "traefik.enable=false"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "{{ db_user }}", "-p{{ vault_db_password }}"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  backend:
    image: "{{ docker_hub_username}}/backend:{{ deploy_version }}"
    environment:
      - DB_HOST=database
      - DB_PORT={{ db_port }}
      - DB_NAME={{ db_name }}
      - DB_USER={{ db_user }}
      - DB_PASSWORD={{ vault_db_password }}
      - ENVIRONMENT={{app_environment}}
    networks:
      - app_network
      - traefik-public
      - monitoring_network
    ports:
      - "5000"
    depends_on:
      - database
    deploy:
      replicas: {{ backend_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          memory: 512M
          cpus: '0.50'
        reservations:
          memory: 256M
          cpus: '0.25'
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.backend.rule=Host(`{{ domain_name }}`) && PathPrefix(`/api`)"
        - "traefik.http.services.backend.loadbalancer.server.port=5000"
        - "traefik.http.routers.backend.entrypoints=web,websecure"
        - "traefik.http.routers.backend.tls.certresolver=letsencrypt"
        - "traefik.docker.network=traefik-public"
        - "prometheus.scrape=true"
        - "prometheus.port=5000"
        - "prometheus.path=/metrics"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ backend_port }}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  frontend:
    image: "{{ docker_hub_username}}/frontend:{{ deploy_version }}"
    environment:
      - REACT_APP_API_URL=http://{{ domain_name }}/api
      - REACT_APP_ENVIRONMENT=production
    networks:
      - traefik-public
    ports:
      - "7000"
    depends_on:
      - backend
    deploy:
      replicas: {{ frontend_replicas }}
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      resources:
        limits:
          memory: 128M
          cpus: '0.25'
        reservations:
          memory: 64M
          cpus: '0.10'
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.frontend.rule=Host(`{{ domain_name }}`)"
        - "traefik.http.routers.frontend.entrypoints=web,websecure"
        - "traefik.http.routers.frontend.tls.certresolver=letsencrypt"
        - "traefik.http.services.frontend.loadbalancer.server.port=7000"
        - "traefik.docker.network=traefik-public"
        # redirection http vers https
        - "traefik.http.routers.frontend-http.rule=Host(`{{ domain_name }}`)"
        - "traefik.http.routers.frontend-http.entrypoints=web"
        - "traefik.http.routers.frontend-http.middlewares=redirect-to-https"
        - "traefik.http.middlewares.redirect-to-https.redirectscheme.scheme=https"

  prometheus:
    image: prom/prometheus:latest
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time={{ prometheus_retention_time }}'
      - '--web.enable-lifecycle'
      - '--web.enable-admin-api'
    volumes:
      - prometheus_data:/prometheus
      - /opt/monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /opt/monitoring/prometheus/console_libraries:/etc/prometheus/console_libraries:ro
      - /opt/monitoring/prometheus/consoles:/etc/prometheus/consoles:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - monitoring_network
      - traefik-public
      - app_network
    deploy:
      placement:
        constraints:
          - node.role == manager
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.prometheus.rule=Host(`{{ prometheus_domain }}`)"
        - "traefik.http.routers.prometheus.entrypoints=web,websecure"
        - "traefik.http.routers.prometheus.tls.certresolver=letsencrypt"
        - "traefik.http.services.prometheus.loadbalancer.server.port=9090"
        - "traefik.docker.network=traefik-public"
        - "traefik.http.routers.prometheus-insecure.rule=Host(`{{ prometheus_domain }}`)"
        - "traefik.http.routers.prometheus-insecure.entrypoints=web"  
        - "traefik.http.routers.prometheus-insecure.middlewares=redirect-to-https" 

  grafana:
    image: grafana/grafana:latest
    environment:
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ vault_grafana_password }}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_DOMAIN={{ grafana_domain }}
      - GF_SERVER_ROOT_URL=https://{{ grafana_domain }}
    volumes:
      - grafana_data:/var/lib/grafana
      - /opt/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - /opt/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring_network
      - traefik-public
    depends_on:
      - prometheus
    deploy:
      placement:
        constraints:
          - node.labels.monitoring.enable==true
      replicas: 1
      restart_policy:
        condition: on-failure
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.grafana.rule=Host(`{{ grafana_domain }}`)"
        - "traefik.http.routers.grafana.entrypoints=web,websecure"
        - "traefik.http.routers.grafana.tls.certresolver=letsencrypt"
        - "traefik.http.services.grafana.loadbalancer.server.port=3000"
        - "traefik.docker.network=traefik-public"

  node-exporter:
    image: prom/node-exporter:latest
    command:
      - '--path.rootfs=/host'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
      - '--collector.systemd'
      - '--web.listen-address=:9100'
    volumes:
      - '/:/host:ro,rslave'
      - '/proc:/host/proc:ro'
      - '/sys:/host/sys:ro'
      - '/var/run/docker.sock:/var/run/docker.sock:ro'
    networks:
      - monitoring_network
    ports:
      - "9100"
    deploy:
      mode: global
      placement:
        constraints:
          - node.platform.os == linux
      restart_policy:
        condition: on-failure
      resources:
        limits:
          memory: 128M
          cpus: '0.10'
        reservations:
          memory: 64M
          cpus: '0.05'
      labels:
        - "traefik.enable=false"

networks:
  traefik-public:
    external: true
  app_network:
    driver: overlay
    attachable: true
  monitoring_network:
    external: true

volumes:
  mysql_data:
    external: true
  prometheus_data:
    external: true
  grafana_data:
    external: true
