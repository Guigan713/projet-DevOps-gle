  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1,"w": 24,"x": 0,"y": 0},
      "id": 1,
      "panels": [],
      "title": "Docker Swarm Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green","value": null},
              {"color": "yellow","value": 2},
              {"color": "red","value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4,"w": 4,"x": 0,"y": 1},
      "id": 2,
      "options": {"colorMode":"value","graphMode":"area","justifyMode":"auto"},
      "targets": [
        {
          "expr": "count(up{job=\"node-exporter\"} == 1)",
          "legendFormat": "Healthy Nodes",
          "refId": "A"
        }
      ],
      "title": "Healthy Swarm Nodes",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red","value": null},
              {"color": "yellow","value": 1},
              {"color": "green","value": 5}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4,"w": 4,"x": 4,"y": 1},
      "id": 3,
      "options": {"colorMode":"value","graphMode":"area","justifyMode":"auto"},
      "targets": [
        {
          "expr": "count(count by (service_name) (up{job=~\"docker-swarm|myapp-backend|traefik\"} == 1))",
          "legendFormat": "Running Swarm Services",
          "refId": "A"
        }
      ],
      "title": "Running Swarm Services",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green","value": null},
              {"color": "yellow","value": 60},
              {"color": "red","value": 90}
            ]
          }
        }
      },
      "gridPos": {"h": 4,"w": 4,"x": 8,"y": 1},
      "id": 4,
      "options": {"colorMode":"value","graphMode":"area","justifyMode":"auto"},
      "targets": [
        {
          "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m])) by (instance) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Average Node CPU Usage (%)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "bytes",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green","value": null},
              {"color": "yellow","value": 70 * 1024 * 1024 * 1024},
              {"color": "red","value": 90 * 1024 * 1024 * 1024}
            ]
          }
        }
      },
      "gridPos": {"h": 4,"w": 4,"x": 12,"y": 1},
      "id": 5,
      "options": {"colorMode":"value","graphMode":"area","justifyMode":"auto"},
      "targets": [
        {
          "expr": "avg(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Average Node Memory Used",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1,"w": 24,"x": 0,"y": 6},
      "id": 6,
      "panels": [],
      "title": "Application Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color":{"mode":"palette-classic"},"unit":"reqps"}},
      "gridPos": {"h": 8,"w": 6,"x": 0,"y": 7},
      "id": 7,
      "options": {
        "legend": {"displayMode":"table"},
        "tooltip": {"mode":"multi"}
      },
      "targets": [
        {
          "expr": "sum(rate(traefik_service_requests_total{code=~\"2..\"}[5m])) by (service)",
          "legendFormat": "2xx - {{service}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traefik_service_requests_total{code=~\"4..\"}[5m])) by (service)",
          "legendFormat": "4xx - {{service}}",
          "refId": "B"
        },
        {
          "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m])) by (service)",
          "legendFormat": "5xx - {{service}}",
          "refId": "C"
        }
      ],
      "title": "HTTP Status Codes (Traefik, par service)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode":"thresholds"},
          "unit":"short"
        }
      },
      "gridPos": {"h": 6,"w": 6,"x": 6,"y": 7},
      "id": 8,
      "options": {},
      "targets": [
        {
          "expr": "up{job=\"myapp-backend\"}",
          "legendFormat": "{{instance}} - Backend up",
          "refId": "A"
        }
      ],
      "title": "Backend Status",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8,"w": 6,"x": 12,"y": 7},
      "id": 9,
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"myapp-backend\"}[5m])",
          "legendFormat": "Backend requests: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Backend Requests/sec",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8,"w": 6,"x": 18,"y": 7},
      "id": 10,
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {
          "expr": "rate(myapp_backend_errors_total[5m])",
          "legendFormat": "Backend errors: {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Backend Errors/sec",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1,"w": 24,"x": 0,"y": 15},
      "id": 11,
      "panels": [],
      "title": "Docker Container Resources",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color":{"mode":"palette-classic"},"unit":"percent"}},
      "gridPos": {"h": 8,"w": 12,"x": 0,"y": 16},
      "id": 12,
      "options": {"legend":{"displayMode":"list"}},
      "targets": [
        {
          "expr": "avg(rate(container_cpu_usage_seconds_total{image!=\"\",name!=\"\"}[5m]) * 100) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "Container CPU Usage (%)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color":{"mode":"palette-classic"},"unit":"bytes"}},
      "gridPos": {"h": 8,"w": 12,"x": 12,"y": 16},
      "id": 13,
      "options": {"legend":{"displayMode":"list"}},
      "targets": [
        {
          "expr": "avg(container_memory_usage_bytes{image!=\"\",name!=\"\"}) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "Container Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"color":{"mode":"palette-classic"},"unit":"short"}},
      "gridPos": {"h": 8,"w": 12,"x": 0,"y": 24},
      "id": 14,
      "options": {"legend":{"displayMode":"list"}},
      "targets": [
        {
          "expr": "max(container_restart_count{image!=\"\",name!=\"\"}) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "Container Restarts",
      "type": "timeseries"
    }
