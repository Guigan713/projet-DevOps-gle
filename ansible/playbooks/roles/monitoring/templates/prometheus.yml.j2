global:
  scrape_interval: 15s

  scrape_configs:
   - job_name: 'prometheus'
     static_configs:
       - targets: ['{{ monitoring_private_ip }}:9090']
     labels:
       service: 'monitoring'

  # Backend sur serveur dédié
   - job_name: 'backend'
     static_configs:
       - targets: ['{{ backend_private_ip }}:5000']
     # ou IP directe: ['10.0.1.100:5000']
     metrics_path: '/metrics'
     scrape_interval: 5s
     scrape_timeout: 10s
     labels:
       service: 'backend'

  # Frontend sur serveur dédié
   - job_name: 'frontend'
     static_configs:
       - targets: ['{{ frontend_private_ip }}:3000']
      # ou IP directe: ['10.0.1.101:3000']
     metrics_path: '/metrics'
     scrape_interval: 15s
     labels:
       service: 'frontend'

  # Base de données avec MySQL Exporter
   - job_name: 'mysql'
     static_configs:
       - targets: ['{{ database_private_ip }}:9104'] # MySQL Exporter, pas MySQL direct
       # ou IP: ['10.0.1.102:9104']
     scrape_interval: 10s
     labels:
       service: 'database'

  # Node Exporter sur chaque serveur
   - job_name: 'node-exporter'
     static_configs:
       - targets: 
           - '{{ frontend_private_ip }}:9100'
           - '{{ backend_private_ip }}:9100'
           - '{{ database_private_ip }}:9100'
           - '{{ monitoring_private_ip }}:9100'
           - 'projet-devops-gle.fr:9100'
     scrape_interval: 15s
     labels:
       service: 'infrastructure'

  # Reverse Proxy (Nginx/HAProxy)
   - job_name: 'reverse-proxy'
     static_configs:
       - targets: ['{{ reverse_proxy_target | default("projet-devops-gle.fr:9113") }}']
     labels:
       service: 'reverse-proxy'

  # Scraper cAdvisor (pour surveiller les conteneurs Docker)
  # - job_name: 'cadvisor'
  #   static_configs:
  #     - targets: ['cadvisor--${ENVIRONMENT}:8080']
