[frontend]
frontend1 ansible_host=10.0.2.3 ansible_user=guillaume

[reverse_proxy]
reverse_proxy1 ansible_host=34.38.190.28 ansible_user=guillaume

[backend]
backend1 ansible_host=10.0.2.4 ansible_user=guillaume

[database]
database1 ansible_host=10.0.2.5 ansible_user=guillaume

[monitoring]
monitoring1 ansible_host=10.0.2.2 ansible_user=guillaume

[all:vars]
ansible_user=guillaume
ansible_ssh_private_key_file=~/.ssh/gcp-ssh-key
ansible_ssh_common_args='-o ProxyCommand="ssh -i ~/.ssh/gcp-ssh-key-W %h:%p -q guillaume@34.38.190.28"'

[reverse_proxy:vars]
ansible_user=guillaume
ansible_port=22
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
