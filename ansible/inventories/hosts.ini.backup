[frontend]
10.0.2.3 ansible_user=ubuntu

[reverse_proxy]
34.38.190.28 ansible_user=ubuntu

[backend]
10.0.2.4 ansible_user=ubuntu

[database]
10.0.2.5 ansible_user=ubuntu

[monitoring]
10.0.2.2 ansible_user=ubuntu


# Group variables for bastion access
[private_servers:children]
frontend
backend
database
monitoring

[private_servers:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q ubuntu@34.38.190.28 -i {{ ansible_ssh_private_key_file }}"'

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
